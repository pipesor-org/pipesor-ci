{
  "name": "pipesor-ci",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "setup:hooks": "lefthook install",
    "commitlint": "bun ./node_modules/@commitlint/cli/cli.js",
    "test": "bun test actions/ && python3 -m unittest discover -s actions/release -p 'test_*.py' && python3 -m unittest discover -s actions/registry-retention -p 'test_*.py'"
  },
  "dependencies": {
    "@commitlint/load": "21.2.4",
    "@commitlint/parse": "21.2.3",
    "semver": "7.8.6"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4"
  }
}
